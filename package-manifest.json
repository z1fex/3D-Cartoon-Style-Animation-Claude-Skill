{
  "name": "3d-cartoon-animation",
  "display_name": "3D Cartoon Animation",
  "version": "1.0.1",
  "created": "2026-10-26",
  "edition": "public (2026-11-11): portable tools, private notes removed; films render the same as 1.0.0",
  "maturity": "owner-approved-on-one-film; method generalised for any topic",
  "entrypoint": "SKILL.md",
  "readme": "README.md",
  "kind": "style-package: markdown skills + a three.js frame-exact renderer + sound and QA tools + a worked example",
  "owner_approval": {
    "round": 1,
    "version": "v3",
    "film": "examples/how-gravity-was-found/final/How gravity was found - v3.mp4",
    "date": "2026-10-26",
    "words": "I really like this. I really liked this video."
  },
  "owner": "the person the films are made for, who approves the storyboard and the film",
  "topic_neutral": true,
  "skill_catalog": [
    {
      "id": "01",
      "name": "topic-to-film",
      "path": "skills/01-topic-to-film/SKILL.md",
      "description": "Turn any topic into a 3D Cartoon Animation film idea - the angle, the hook, the cast, the places, the numbers that become objects, and the one big literal picture. Use first, before writing the script."
    },
    {
      "id": "02",
      "name": "script-and-retention",
      "path": "skills/02-script-and-retention/SKILL.md",
      "description": "Write a retention-first narration for a 3D Cartoon Animation short - hook, early payoff, stakes, escalation, re-hook, twist, loop - at about 3.3 words a second, one idea per clause, with every claim sourced. Use after topic-to-film and before the voiceover."
    },
    {
      "id": "03",
      "path": "skills/03-voiceover-and-timing/SKILL.md"
    },
    {
      "id": "04",
      "path": "skills/04-storyboard-and-shot-plan/SKILL.md"
    },
    {
      "id": "05",
      "name": "look-lighting-and-brand",
      "path": "skills/05-look-lighting-and-brand/SKILL.md",
      "description": "The \"Cinema\" toon look of the 3D Cartoon Animation style (soft banded shading, ink outlines, rim light, depth of field, bloom, grade, grain), the light presets, and how the owner's brand palette is used on clothes, props, sets and real-world objects. Use when building any place, prop or character."
    },
    {
      "id": "06",
      "name": "characters-and-faces",
      "path": "skills/06-characters-and-faces/SKILL.md",
      "description": "Build original 3D cartoon characters for any topic (ball head, bean body, stick limbs, mitten hands) with skin tones, brand-colour outfits, hair, hats, glasses and beards, and act them with painted faces that swap through a blink. Use when casting a film."
    },
    {
      "id": "07",
      "name": "motion-and-acting",
      "path": "skills/07-motion-and-acting/SKILL.md",
      "description": "Act every clause of a 3D Cartoon Animation film - pose keys that land 4 frames before their word, dead-still holds, head follow-through, real-gravity falls and physical gags - with the engine's pose library. Use when building each shot."
    },
    {
      "id": "08",
      "name": "camera-and-transitions",
      "path": "skills/08-camera-and-transitions/SKILL.md",
      "description": "Frame and move the camera in a 3D Cartoon Animation film - an orbit around a named subject placed 43% from the top, 44-50° vertical fov, a travel curve that is fast at the cuts and creeps between them, and 6-frame dissolves on the first word of each sentence. Use for every shot."
    },
    {
      "id": "09",
      "name": "facts-as-objects",
      "path": "skills/09-facts-as-objects/SKILL.md",
      "description": "Turn every spoken number in a 3D Cartoon Animation film into an in-world device that lands on its exact word - flip counters, calendars, tape measures, LED panels, signs, gauges - and choose the right device for each kind of number. Use for every number in the script."
    },
    {
      "id": "10",
      "name": "sets-and-props",
      "path": "skills/10-sets-and-props/SKILL.md",
      "description": "Build the places of a 3D Cartoon Animation film for any topic from the place kit (exterior, interior, studio void, outer space), dress them densely with props in brand colours, and make new props in the style. Use when planning and building each place."
    },
    {
      "id": "11",
      "name": "captions-and-title-hook",
      "path": "skills/11-captions-and-title-hook/SKILL.md",
      "description": "Write and lay out the on-screen text of a 3D Cartoon Animation film - the topic question at the top for the first 2-3 seconds, and editorial caption lockups (Helvetica Bold capitals + Editorial New Italic in brand red, stacked, mixed sizes, word-by-word reveal). Use after the script and voice timings exist."
    },
    {
      "id": "12",
      "name": "sound-design-and-mix",
      "path": "skills/12-sound-design-and-mix/SKILL.md",
      "description": "Design the sound of a 3D Cartoon Animation film - an original music bed, a quiet foley sound on every visible action, accents on story beats, measured levels against the voice, stop-downs before the biggest hits - with the engine's 24 synthesised effects, and master it to -14 LUFS. Use after the picture is locked."
    },
    {
      "id": "13",
      "path": "skills/13-render-and-quality-checks/SKILL.md"
    },
    {
      "id": "14",
      "name": "review-rounds-and-learning",
      "path": "skills/14-review-rounds-and-learning/SKILL.md",
      "description": "Run review rounds with the owner on a 3D Cartoon Animation film (deliver, take feedback, fix, re-check every frame, re-deliver), record what was learned, and fold it back into this package so the next topic starts better. Use after each delivery and whenever the owner gives feedback."
    }
  ],
